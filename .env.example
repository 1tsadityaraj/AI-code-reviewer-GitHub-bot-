# ─── GitHub App Configuration ────────────────────────────────────
# Get these from https://github.com/settings/apps
APP_ID=your_github_app_id
PRIVATE_KEY_PATH=./private-key.pem
WEBHOOK_SECRET=your_webhook_secret

# ─── Google Gemini API ──────────────────────────────────────────
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# ─── Optional Configuration ─────────────────────────────────────
# Gemini model to use (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Max files to review per PR (default: 15)
MAX_FILES_PER_REVIEW=15

# Max diff size in characters per file (default: 12000)
MAX_DIFF_SIZE=12000

# Log level (default: info)
LOG_LEVEL=info

# Port for webhook server (default: 3000)
PORT=3000
